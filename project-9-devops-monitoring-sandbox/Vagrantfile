Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/focal64"
  config.vm.hostname = "devops-monitor"
  config.vm.boot_timeout = 600

  config.vm.provider "virtualbox" do |vb|
    vb.name = "monitoring-sandbox"
    vb.memory = "4096"
    vb.cpus = 2
  end

  config.vm.network "private_network", ip: "192.168.56.10"

  # Port forwarding for services
  config.vm.network "forwarded_port", guest: 9090, host: 9090   # Prometheus
  config.vm.network "forwarded_port", guest: 3000, host: 3000   # Grafana
  config.vm.network "forwarded_port", guest: 9093, host: 9093   # Alertmanager
  config.vm.network "forwarded_port", guest: 9100, host: 9100   # Node Exporter
  config.vm.network "forwarded_port", guest: 22, host: 2222     # SSH

  config.vm.provision "shell", path: "provision.sh"
end

